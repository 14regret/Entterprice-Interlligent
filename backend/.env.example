# =============================================================================
#  Nexus 智询 — backend environment
#  Copy to .env, then restart uvicorn. Local defaults are shown.
#  All paths are resolved relative to backend/ unless absolute.
# =============================================================================

# --- Ollama ------------------------------------------------------------------
# Local daemon only; do not point this at a public host.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Generation model. Switch to qwen2.5:3b / 7b after `ollama pull`, then restart.
# No application code changes are needed.
CHAT_MODEL=qwen2:1.5b

# Embedding model (768 dimensions). Changing it invalidates every vector:
# stop the backend, delete data/chroma + data/index, then re-upload documents.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# --- Redis (redis.asyncio, RESP2 because the local server is Redis 5.x) ------
REDIS_URL=redis://127.0.0.1:6379/0

# Session memory: last N turns, sliding TTL.
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=6

# Global token bucket for POST /api/chat.
RATE_LIMIT_PER_MINUTE=30

# Semantic cache: Chroma ANN recall + Redis answer payload.
# 0.92 means "almost the same question"; lower it for more hits, fewer tokens.
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400

# nomic-embed-text gives some unrelated short questions ~0.997 similarity, so
# the vector threshold alone is not safe. A cached question must also cover at
# least this share of the new question's content words.
CACHE_MIN_QUESTION_OVERLAP=0.35

# How many recent vectors Redis keeps for the numpy fallback when Chroma is
# unavailable. Each entry is a base64 float32 vector.
CACHE_RECENT_LIMIT=100

# --- Storage -----------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
BM25_PATH=./data/index/bm25.pkl

# --- Chunking / retrieval ----------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=120

VECTOR_TOP_K=8
KEYWORD_TOP_K=8
FUSION_TOP_K=6
RRF_K=60

# Retrieval gate: if the best cosine is below this AND the best keyword
# coverage is below the next value, refuse without calling the model.
MIN_CONTEXT_SIMILARITY=0.60
MIN_KEYWORD_COVERAGE=0.55

# Evidence margin. Prefer chunks that actually contain query words; only fall
# back to cosine when no chunk covers the query (pure paraphrase).
EVIDENCE_COVERAGE=0.30
EVIDENCE_SIMILARITY=0.65

# --- Upload / generation -----------------------------------------------------
MAX_UPLOAD_MB=20
GENERATION_TIMEOUT_SECONDS=180

# --- HTTP --------------------------------------------------------------------
# The Vite dev proxy is same-origin, so this only matters for direct API calls.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
